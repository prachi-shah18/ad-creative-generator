# Copy to .env for local use. A blank key keeps the app in demo mode.
HOST=127.0.0.1
PORT=4173
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional OpenAI-compatible HTTPS endpoint override
# OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions
AI_TIMEOUT_MS=30000
AI_REQUESTS_PER_MINUTE=20
